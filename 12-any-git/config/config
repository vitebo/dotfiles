# ~/.config/git/config -> 12-any-git/config/config

[user]
    name = vitebo
    email = vitebo@hotmail.com

# delta (29-any-git-delta) as the pager; ignored when the file doesn't exist,
# ie where the package isn't installed.
[include]
    path = ~/.config/git-delta/git-delta.config

# gh's login as credentials for https on GitHub (35-any-gh); ignored when the file
# doesn't exist, ie where the package isn't installed.
[include]
    path = ~/.config/gh/git-credential.config
