# ~/.config/sketchybar/sketchybarrc -> 24-mac-sketchybar/config/sketchybar/sketchybarrc
#
# SketchyBar's demo config, with a few changes marked "dotfiles:".
#
# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

# dotfiles: Catppuccin colors following the macOS appearance (colors.sh).
source "$CONFIG_DIR/colors.sh"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

# dotfiles: color from colors.sh (default: 0x40000000)
sketchybar --bar position=top height=40 blur_radius=30 color=$BAR_COLOR

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

# dotfiles: JetBrainsMono Nerd Font (18-mac-nerd-font) instead of Hack Nerd Font,
# and text colors from colors.sh (default: 0xffffffff)
default=(
  padding_left=5
  padding_right=5
  icon.font="JetBrainsMono Nerd Font:Bold:17.0"
  label.font="JetBrainsMono Nerd Font:Bold:14.0"
  icon.color=$TEXT_COLOR
  label.color=$TEXT_COLOR
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Adding User Indicator #####
# dotfiles: Apple logo (nf-fa-apple) and the user name, first on the left.
# The user name doesn't change, so no plugin script.

sketchybar --add item user left \
           --set user icon= label="$(id -un)"

##### Adding AeroSpace Workspace Indicators #####
# dotfiles: AeroSpace workspaces instead of Mission Control spaces (AeroSpace
# doesn't use them), from AeroSpace's SketchyBar integration:
# https://nikitabobko.github.io/AeroSpace/goodies
# AeroSpace triggers aerospace_workspace_change (see its exec-on-workspace-change).
# dotfiles: no icon and even label padding (like the demo's space items), so the
# number stays centered in the highlight.

sketchybar --add event aerospace_workspace_change

# dotfiles: the workspaces listed are AeroSpace's persistent ones (read from its
# config), not `aerospace list-workspaces --all`: that also returns temporary ones
# (eg "10", created for a second monitor) and the bar only reads it at startup, so
# they'd stay after AeroSpace drops them.
WORKSPACES="$(grep '^persistent-workspaces' "$HOME/.config/aerospace/aerospace.toml" | grep -o '"[^"]*"' | tr -d '"')"
if [ -z "$WORKSPACES" ]; then
    WORKSPACES="$(aerospace list-workspaces --all)"
fi

for sid in $WORKSPACES; do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        background.color=$HIGHLIGHT_COLOR \
        background.corner_radius=5 \
        background.height=20 \
        background.drawing=off \
        icon.drawing=off \
        label="$sid" \
        label.padding_left=7 \
        label.padding_right=7 \
        click_script="aerospace workspace $sid" \
        script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

##### Adding Left Items #####
# We add some regular items to the left side of the bar, where
# only the properties deviating from the current defaults need to be set

sketchybar --add item chevron left \
           --set chevron icon= label.drawing=off \
           --add item front_app left \
           --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other items respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add item clock right \
           --set clock update_freq=10 icon=  script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

##### Adding Slack Unread Indicator #####
# dotfiles: Slack (38-mac-slack) icon (nf-fa-slack) with its unread state (see
# plugins/slack.sh). Refreshed every 10s and when the focused app changes (eg
# after reading messages); a click opens Slack (AeroSpace then shows its
# workspace, 9).

sketchybar --add item slack right \
           --set slack icon= update_freq=10 script="$PLUGIN_DIR/slack.sh" \
                 click_script="open -a Slack" \
                 background.corner_radius=5 background.height=20 background.drawing=off \
           --subscribe slack front_app_switched system_woke

##### Adding Claude Code Usage Indicator #####
# dotfiles: Claude Code (21-any-claude-code) plan usage, 5-hour and 7-day windows
# (nf-cod-claude icon, see plugins/claude_usage.sh). Its status line triggers
# claude_usage_changed each time it saves new usage; every 60s also catches a
# window reset.

sketchybar --add event claude_usage_changed \
           --add item claude_usage right \
           --set claude_usage icon= update_freq=60 script="$PLUGIN_DIR/claude_usage.sh" \
                 background.corner_radius=5 background.height=20 background.drawing=off \
           --subscribe claude_usage claude_usage_changed system_woke

##### Adding AWS Client VPN Indicator #####
# dotfiles: AWS Client VPN (52-mac-aws-vpn-client) cloud icon, with a lock when
# connected, crossed out and dimmed when not (see plugins/aws_vpn.sh). Refreshed every 5s; a click opens
# the client.

sketchybar --add item aws_vpn right \
           --set aws_vpn icon=󰅤 update_freq=5 script="$PLUGIN_DIR/aws_vpn.sh" \
                 click_script="open -a 'AWS VPN Client'" \
           --subscribe aws_vpn system_woke

##### Following the macOS Appearance #####
# dotfiles: macOS posts AppleInterfaceThemeChangedNotification when it switches
# between light and dark mode; an invisible item reloads the bar then (see
# plugins/appearance.sh), so colors.sh picks the other Catppuccin flavor.

sketchybar --add event appearance_changed AppleInterfaceThemeChangedNotification \
           --add item appearance left \
           --set appearance drawing=off script="$PLUGIN_DIR/appearance.sh" \
           --subscribe appearance appearance_changed

# dotfiles: Light / Dark / System button, on the right: the icon shows the current
# macOS appearance, a click opens a popup to pick another (plugins/appearance_mode.sh;
# System is macOS' Auto appearance). Every tool follows from there.

sketchybar --add event appearance_mode_changed \
           --add item appearance_mode right \
           --set appearance_mode script="$PLUGIN_DIR/appearance_mode.sh" \
                 click_script="sketchybar --set appearance_mode popup.drawing=toggle" \
                 popup.align=right popup.background.color=$POPUP_COLOR \
                 popup.background.corner_radius=5 popup.background.border_width=1 \
                 popup.background.border_color=$HIGHLIGHT_COLOR \
           --subscribe appearance_mode appearance_mode_changed mouse.exited.global

for mode in light dark system; do
    case "$mode" in
        light)  icon=󰖨 label="Light" ;;
        dark)   icon=󰖔 label="Dark" ;;
        system) icon=󰔎 label="System" ;;
    esac
    sketchybar --add item appearance_mode.$mode popup.appearance_mode \
               --set appearance_mode.$mode icon="$icon" label="$label" \
                     background.color=$HIGHLIGHT_COLOR background.corner_radius=5 \
                     background.height=24 background.drawing=off \
                     click_script="$PLUGIN_DIR/appearance_mode.sh $mode"
done

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
