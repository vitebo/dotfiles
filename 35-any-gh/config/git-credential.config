# ~/.config/gh/git-credential.config -> 35-any-gh/config/git-credential.config
#
# git uses gh's login for https on GitHub, what `gh auth setup-git` would write
# (without gh's absolute path, so it works on mac and linux). Included by
# ~/.config/git/config (12-any-git); ignored where gh isn't installed.
# The empty `helper =` drops other helpers (eg macOS keychain) for these hosts.

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
