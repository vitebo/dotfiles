#!/bin/bash
# ~/.config/borders/bordersrc -> 25-mac-jankyborders/config/bordersrc
#
# JankyBorders' example config. Options: `man borders`.
# Run by `borders` when started without arguments; running this script again
# updates the running instance.

options=(
	style=round
	width=6.0
	hidpi=off
	active_color=0xffe2e2e3
	inactive_color=0xff414550
)

borders "${options[@]}"
