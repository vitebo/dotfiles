# ~/.config/ghostty/config.ghostty -> packages/ghostty/config/config.ghostty
#
# Ghostty defaults for now. Options: https://ghostty.org/docs/config/reference
# Reload with cmd+shift+, ; list every option with `ghostty +show-config --default --docs`.

# dotfiles: Catppuccin, Latte in light mode and Mocha in dark mode, following the
# macOS appearance live. Terminal tools (host and devcontainers) are configured to
# follow Ghostty's colors and light / dark mode. (default: none)
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# dotfiles: cmd+t opens a new window instead of a native tab. macOS native tabs are
# separate windows for tiling window managers, so AeroSpace (packages/aerospace)
# tiles each tab on its own; its accordion layout (alt-,) acts as tabs instead.
keybind = super+t=new_window

# dotfiles: no titlebar (close / minimize / maximize buttons): AeroSpace
# (packages/aerospace) places and sizes windows, so it only takes space. Unlike
# `window-decoration = none`, the frame and rounded corners stay. Applies to new
# windows. (default: transparent)
macos-titlebar-style = hidden

# dotfiles: more room between the text and the window edges (default: 2 points
# each), and the leftover space (window size not a multiple of the cell size)
# spread over all edges instead of only the right / bottom. Applies to new windows.
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true

# dotfiles: the left option key acts as alt, so terminal apps get alt shortcuts
# (eg Claude Code's option+enter newline, option+p model picker). The Brazilian
# layout defaults to false (option types characters); the right option key still
# does. AeroSpace (packages/aerospace) grabs its alt shortcuts first. (default: unset,
# true only on U.S. layouts)
macos-option-as-alt = left
