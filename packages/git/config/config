# ~/.config/git/config -> packages/git/config/config

[user]
    name = vitebo
    email = vitebo@hotmail.com

# delta (packages/git-delta) as the pager; ignored when the file doesn't exist,
# ie where the package isn't installed.
[include]
    path = ~/.config/git-delta/git-delta.config

# gh's login as credentials for https on GitHub (packages/gh); ignored when the file
# doesn't exist, ie where the package isn't installed.
[include]
    path = ~/.config/gh/git-credential.config

# Machine-only overrides (eg the work identity in [user]), kept out of the repo;
# ignored when the file doesn't exist. Last, so it wins over everything above.
[include]
    path = ~/.config/git/config.local
