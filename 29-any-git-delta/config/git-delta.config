# ~/.config/git-delta/git-delta.config -> 29-any-git-delta/config/git-delta.config
#
# delta's recommended git config (README, "Get started"), included by
# ~/.config/git/config (12-any-git). Options: `delta --help`.

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    # dotfiles: no `dark = true`: delta detects the terminal's light / dark mode
    # (lazygit passes it with --dark / --light) and uses its own light / dark line
    # backgrounds. Syntax colors from the terminal's 16 ANSI colors, so they
    # follow Ghostty's Catppuccin flavor in both modes.
    syntax-theme = ansi

[merge]
    conflictStyle = zdiff3
