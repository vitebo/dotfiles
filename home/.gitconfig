[user]
	name = vitebo
	email = vitebo@hotmail.com

[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = input

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[color]
	ui = auto

[alias]
	st = status
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate

# Machine-specific overrides (signing keys, a different user.email, ...).
# This file is not versioned; git silently ignores it when missing. Because
# it is included last, anything here overrides the versioned defaults above.
[include]
	path = ~/.config/dotfiles/gitconfig.local
