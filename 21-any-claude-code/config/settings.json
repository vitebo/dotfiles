{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "theme": "auto",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "auto",
  "preferredNotifChannel": "ghostty",
  "editorMode": "vim",
  "statusLine": {
    "type": "command",
    "command": "f=\"$HOME/.claude/statusline.sh\"; [ ! -f \"$f\" ] || bash \"$f\""
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/tmux-agent-state.sh\"; [ ! -f \"$f\" ] || bash \"$f\" working"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/tmux-agent-state.sh\"; [ ! -f \"$f\" ] || bash \"$f\" working"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/tmux-agent-state.sh\"; [ ! -f \"$f\" ] || bash \"$f\" attention"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/tmux-agent-state.sh\"; [ ! -f \"$f\" ] || bash \"$f\" attention"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/tmux-agent-state.sh\"; [ ! -f \"$f\" ] || bash \"$f\" done"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/tmux-agent-state.sh\"; [ ! -f \"$f\" ] || bash \"$f\" done"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/tmux-agent-state.sh\"; [ ! -f \"$f\" ] || bash \"$f\" clear"
          }
        ]
      }
    ]
  }
}
