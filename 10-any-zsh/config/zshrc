# ~/.zshrc -> 10-any-zsh/config/zshrc
#
# Loads the packages' snippets from ~/.config/zsh/<NN>-<name>.zsh (in package
# order), then completion, then ~/.zshrc.local (machine specific config, kept
# out of the repository).
# `(N-.)` skips dangling symlinks, eg from a removed package.

for _dot_zsh_file in "${HOME}"/.config/zsh/*.zsh(N-.); do
    source "${_dot_zsh_file}"
done
unset _dot_zsh_file

# After the snippets, so every package's `fpath` addition is picked up.
autoload -Uz compinit && compinit

if [[ -f "${HOME}/.zshrc.local" ]]; then
    source "${HOME}/.zshrc.local"
fi
